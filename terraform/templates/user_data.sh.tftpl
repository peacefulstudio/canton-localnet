#!/bin/bash
# Copyright (c) 2026 Peaceful Studio OÜ
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

LOG=/var/log/canton-localnet-bootstrap.log
DONE_FLAG=/var/lib/canton-localnet-bootstrap.done
exec > >(tee -a "$LOG") 2>&1
echo "==> canton-localnet bootstrap starting at $(date -u +%FT%TZ)"

if [ -f "$DONE_FLAG" ]; then
  echo "==> $DONE_FLAG already present — bootstrap previously succeeded, exiting"
  exit 0
fi

apt-get update -o Acquire::Retries=3
apt-get install -y -o Acquire::Retries=3 git ca-certificates curl make

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -o Acquire::Retries=3
apt-get install -y -o Acquire::Retries=3 docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

REPO_URL="${repo_url}"
REPO_NAME="$${REPO_URL##*/}"
REPO_NAME="$${REPO_NAME%.git}"
HOME_DIR=/home/ubuntu
REPO_DIR="$HOME_DIR/$REPO_NAME"

if [ -d "$REPO_DIR" ] && [ ! -d "$REPO_DIR/.git" ]; then
  rm -rf "$REPO_DIR"
fi

AUTH_HEADER=""
REPO_TOKEN="${repo_token}"
if [ -n "$REPO_TOKEN" ]; then
  AUTH_HEADER="Authorization: Basic $(printf 'x-access-token:%s' "$REPO_TOKEN" | base64 -w0)"
else
  echo "WARN: repo_token empty — cloning unauthenticated (only works for a public repo)" >&2
fi
unset REPO_TOKEN

run_git() {
  if [ -n "$AUTH_HEADER" ]; then
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraHeader GIT_CONFIG_VALUE_0="$AUTH_HEADER" sudo -u ubuntu --preserve-env=GIT_CONFIG_COUNT,GIT_CONFIG_KEY_0,GIT_CONFIG_VALUE_0 git "$@"
  else
    sudo -u ubuntu git "$@"
  fi
}

if [ ! -d "$REPO_DIR/.git" ]; then
  run_git clone "$REPO_URL" "$REPO_DIR"
fi

run_git -C "$REPO_DIR" fetch --all --prune
run_git -C "$REPO_DIR" checkout "${repo_ref}"
if run_git -C "$REPO_DIR" symbolic-ref -q HEAD >/dev/null; then
  run_git -C "$REPO_DIR" pull --ff-only || { echo "FATAL: ff-only pull failed — branch diverged, refusing to deploy stale checkout" >&2; exit 1; }
fi
unset AUTH_HEADER

if ! getent group docker >/dev/null; then
  echo "Error: docker group missing after docker install — aborting bootstrap" >&2
  exit 1
fi

sudo -u ubuntu sg docker -c "cd '$REPO_DIR' && make up"

mkdir -p "$(dirname "$DONE_FLAG")"
date -u +%FT%TZ > "$DONE_FLAG"
echo "==> canton-localnet bootstrap complete at $(date -u +%FT%TZ)"
