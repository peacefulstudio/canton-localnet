## Variables for substitution in docker-compose files
## Container specific variables are placed in the respective container's --env-file

IMAGE_REPO=${IMAGE_REPO:-ghcr.io/digital-asset/decentralized-canton-sync/docker/} # Publicly released images


POSTGRES_VERSION=${POSTGRES_VERSION:-17}
NGINX_VERSION=${NGINX_VERSION:-1.30.0}

DOCKER_NETWORK=${DOCKER_NETWORK:-localnet}

LOCALNET_DIR=${LOCALNET_DIR:-.}
LOCALNET_ENV_DIR=${LOCALNET_ENV_DIR:-$LOCALNET_DIR/env}

SV_VALIDATOR_1_PROFILE=${SV_VALIDATOR_1_PROFILE:-on}
A_VALIDATOR_1_PROFILE=${A_VALIDATOR_1_PROFILE:-on}
B_VALIDATOR_1_PROFILE=${B_VALIDATOR_1_PROFILE:-on}
C_VALIDATOR_1_PROFILE=${C_VALIDATOR_1_PROFILE:-off}
D_VALIDATOR_1_PROFILE=${D_VALIDATOR_1_PROFILE:-on}

A_VALIDATOR_1_AUTH_ENV=${LOCALNET_ENV_DIR}/a-validator-1-auth-${A_VALIDATOR_1_PROFILE}.env
B_VALIDATOR_1_AUTH_ENV=${LOCALNET_ENV_DIR}/b-validator-1-auth-${B_VALIDATOR_1_PROFILE}.env
C_VALIDATOR_1_AUTH_ENV=${LOCALNET_ENV_DIR}/c-validator-1-auth-${C_VALIDATOR_1_PROFILE}.env
SV_VALIDATOR_1_AUTH_ENV=${LOCALNET_ENV_DIR}/sv-validator-1-auth-${SV_VALIDATOR_1_PROFILE}.env
D_VALIDATOR_1_AUTH_ENV=${LOCALNET_ENV_DIR}/d-validator-1-auth-${D_VALIDATOR_1_PROFILE}.env


PARTY_HINT=${PARTY_HINT:-$DOCKER_NETWORK-localparty-1}


