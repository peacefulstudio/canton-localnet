KEYCLOAK_IMAGE=${KEYCLOAK_IMAGE:-quay.io/keycloak/keycloak}
KEYCLOAK_VERSION=${KEYCLOAK_VERSION:-26.6.1}

A_VALIDATOR_1_AUTH_ENV=${MODULES_DIR}/keycloak/env/a-validator-1/${A_VALIDATOR_1_PROFILE}/oauth2.env
B_VALIDATOR_1_AUTH_ENV=${MODULES_DIR}/keycloak/env/b-validator-1/${B_VALIDATOR_1_PROFILE}/oauth2.env
C_VALIDATOR_1_AUTH_ENV=${MODULES_DIR}/keycloak/env/c-validator-1/${C_VALIDATOR_1_PROFILE}/oauth2.env
D_VALIDATOR_1_AUTH_ENV=${MODULES_DIR}/keycloak/env/d-validator-1/${D_VALIDATOR_1_PROFILE}/oauth2.env

AUTH_A_VALIDATOR_1_ISSUER_URL=http://keycloak.localhost:8082/realms/AValidator1                            # for backend oidc client conf, wallet-ui
AUTH_A_VALIDATOR_1_ISSUER_URL_INTERNAL=http://nginx-keycloak:8082/realms/AValidator1                        # for backends
AUTH_A_VALIDATOR_1_WELLKNOWN_URL=${AUTH_A_VALIDATOR_1_ISSUER_URL_INTERNAL}/.well-known/openid-configuration  # for validator
AUTH_A_VALIDATOR_1_TOKEN_URL=${AUTH_A_VALIDATOR_1_ISSUER_URL_INTERNAL}/protocol/openid-connect/token         # for pqs, canton-console, onboarding
AUTH_A_VALIDATOR_1_JWK_SET_URL=${AUTH_A_VALIDATOR_1_ISSUER_URL_INTERNAL}/protocol/openid-connect/certs       # for participant, validator
AUTH_A_VALIDATOR_1_AUDIENCE=https://canton.network.global

AUTH_B_VALIDATOR_1_ISSUER_URL_INTERNAL=http://nginx-keycloak:8082/realms/BValidator1                                # for backend
AUTH_B_VALIDATOR_1_ISSUER_URL=http://keycloak.localhost:8082/realms/BValidator1                                    # for backend, wallet-ui
AUTH_B_VALIDATOR_1_WELLKNOWN_URL=${AUTH_B_VALIDATOR_1_ISSUER_URL_INTERNAL}/.well-known/openid-configuration          # for validator
AUTH_B_VALIDATOR_1_TOKEN_URL=${AUTH_B_VALIDATOR_1_ISSUER_URL_INTERNAL}/protocol/openid-connect/token                 # for scribe, canton-console, onboarding
AUTH_B_VALIDATOR_1_JWK_SET_URL=${AUTH_B_VALIDATOR_1_ISSUER_URL_INTERNAL}/protocol/openid-connect/certs               # for participant, validator
AUTH_B_VALIDATOR_1_AUDIENCE=https://canton.network.global

AUTH_C_VALIDATOR_1_ISSUER_URL_INTERNAL=http://nginx-keycloak:8082/realms/CValidator1                                # for backend
AUTH_C_VALIDATOR_1_ISSUER_URL=http://keycloak.localhost:8082/realms/CValidator1                                    # for backend, wallet-ui
AUTH_C_VALIDATOR_1_WELLKNOWN_URL=${AUTH_C_VALIDATOR_1_ISSUER_URL_INTERNAL}/.well-known/openid-configuration          # for validator
AUTH_C_VALIDATOR_1_TOKEN_URL=${AUTH_C_VALIDATOR_1_ISSUER_URL_INTERNAL}/protocol/openid-connect/token                 # for scribe, canton-console, onboarding
AUTH_C_VALIDATOR_1_JWK_SET_URL=${AUTH_C_VALIDATOR_1_ISSUER_URL_INTERNAL}/protocol/openid-connect/certs               # for participant, validator
AUTH_C_VALIDATOR_1_AUDIENCE=https://canton.network.global

AUTH_D_VALIDATOR_1_ISSUER_URL_INTERNAL=http://nginx-keycloak:8082/realms/DValidator1                                # for backend
AUTH_D_VALIDATOR_1_ISSUER_URL=http://keycloak.localhost:8082/realms/DValidator1                                    # for backend, wallet-ui
AUTH_D_VALIDATOR_1_WELLKNOWN_URL=${AUTH_D_VALIDATOR_1_ISSUER_URL_INTERNAL}/.well-known/openid-configuration          # for validator
AUTH_D_VALIDATOR_1_TOKEN_URL=${AUTH_D_VALIDATOR_1_ISSUER_URL_INTERNAL}/protocol/openid-connect/token                 # for scribe, canton-console, onboarding
AUTH_D_VALIDATOR_1_JWK_SET_URL=${AUTH_D_VALIDATOR_1_ISSUER_URL_INTERNAL}/protocol/openid-connect/certs               # for participant, validator
AUTH_D_VALIDATOR_1_AUDIENCE=https://canton.network.global
