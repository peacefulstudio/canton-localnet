# Default environment for `make up`. Override per-shell, per-CI, or per-developer
# by exporting variables before invoking make, or by maintaining a sibling
# `.env.local` (gitignored) and `--env-file`-loading it ahead of this file.

SPLICE_VERSION=0.6.5
IMAGE_TAG=${SPLICE_VERSION}

# AUTH_MODE selects the auth profile applied to the stack:
#   oauth2  — Keycloak realms issue tokens (matches shared VM and production)
#   secret  — Canton's shared-secret JWT (undocumented escape hatch; not CI-tested)
AUTH_MODE=oauth2

# Party hint format: <consumer-prefix>-<role>-<n>. Override per consumer
# (acme-, globex-, initech-, hooli-) and per fixture instance.
A_VALIDATOR_1_PARTY_HINT=localnet-validator-1
C_VALIDATOR_1_PARTY_HINT=bob-validator-1
PARTY_HINT=localnet-localparty-1

DOCKER_NETWORK=localnet
